# Optional: EmailJS for the contact form (https://www.emailjs.com).
# Copy this file to .env.local and fill in the three values, then rebuild.
# Without them, the form falls back to opening the visitor's email app (mailto).
# These values are embedded in the public JS bundle — EmailJS public keys are meant to be public.
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
